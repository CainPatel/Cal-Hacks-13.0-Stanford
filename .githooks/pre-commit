#!/bin/sh
# Refuse to commit secrets. Enabled per clone by `make hooks`. Bypassing (--no-verify) is never OK here:
# this repo is public, and anything pushed is public forever.
fail=0

# 1. Secret files, wherever they are
bad_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)|\.pem$|\.key$|\.p12$|id_rsa|id_ed25519|wifi_secrets\.h$' | grep -v '\.env\.example$')
if [ -n "$bad_files" ]; then
  echo "BLOCKED: these files hold secrets and must never be committed:"; echo "$bad_files" | sed 's/^/  /'; fail=1
fi

# 2. Key-shaped strings in the lines being added
hits=$(git diff --cached -U0 --no-color | grep -E '^\+[^+]' | grep -nE \
  'sk-ant-[A-Za-z0-9_-]{10,}|vck_[A-Za-z0-9]{10,}|ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|xox[baprs]-[A-Za-z0-9-]{10,}|(API_KEY|_TOKEN|_SECRET)=[A-Za-z0-9_-]{16,}')
if [ -n "$hits" ]; then
  echo "BLOCKED: this commit adds something that looks like a key:"
  echo "$hits" | sed -E 's/(\+?[^=:"]{0,30}[=:"] ?.{0,6}).*/  \1… (rest hidden)/'; fail=1
fi

if [ $fail -ne 0 ]; then
  echo "Keep keys in .env (gitignored). Share them with teammates by DM, never in the repo."
  exit 1
fi
