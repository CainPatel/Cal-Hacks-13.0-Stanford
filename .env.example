# Copy to .env and fill in. .env is gitignored; share real values by DM, never in the repo.
ANTHROPIC_API_KEY=
# TypeSafe Jev. With a key from TypeSafe itself: set both of these.
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
# ...or through Vercel AI Gateway instead (leave JEV_BASE_URL unset): AI_GATEWAY_API_KEY (or JEV_API_KEY)
AI_GATEWAY_API_KEY=
# Capital One Nessie sandbox (pretend bank). `python -m events nessie-setup` once prints NESSIE_ACCOUNT_ID.
NESSIE_API_KEY=
NESSIE_ACCOUNT_ID=
# CRS sandbox (vendor identity, rule 09): username/password from CRS's email, or a bearer token in CRS_API_KEY
CRS_USERNAME=
CRS_PASSWORD=
CRS_API_KEY=
DEVICE_URL=http://192.168.0.0
# Optional: the approval key's public key, if not yet in config/contract.yaml (local mock: curl :8001/pubkey)
APPROVAL_KEY_PUBKEY=
