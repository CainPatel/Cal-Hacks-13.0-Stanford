# Copy to .env and fill in. .env is gitignored; share real values by DM, never in the repo.
ANTHROPIC_API_KEY=
# TypeSafe Jev via Vercel AI Gateway (default route; model typesafe-ai/jev). Either name works.
JEV_API_KEY=
AI_GATEWAY_API_KEY=
# Capital One Nessie sandbox (pretend bank). Run `python -m events nessie-setup` once to get the account id.
NESSIE_API_KEY=
NESSIE_ACCOUNT_ID=
CRS_API_KEY=
# Approval key (Pi or ESP32). Local mock: `make device` on http://localhost:8001
ESP32_DEVICE_URL=
# Its public key (GET /pubkey on the device) if not yet in config/contract.yaml esp32_pubkey
APPROVAL_KEY_PUBKEY=
